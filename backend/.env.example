# Copy to backend/.env (or export these variables). Every setting is optional.
# With nothing set, the backend behaves exactly as before (pandas only).

# ---- Apache Cassandra ------------------------------------------------------
# Cassandra is used only when CASSANDRA_HOSTS is set (or CASSANDRA_ENABLED=true).
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=weather_analytics
# CASSANDRA_ENABLED=true            # force on/off (auto = on when CASSANDRA_HOSTS is set)
# CASSANDRA_USERNAME=
# CASSANDRA_PASSWORD=
# CASSANDRA_REPLICATION_FACTOR=1    # SimpleStrategy replication factor (dev default)
# CASSANDRA_CONNECT_TIMEOUT=5       # seconds
# CASSANDRA_RETRY_SECONDS=30        # wait before re-trying after a failed connection
# CASSANDRA_WRITE_CONCURRENCY=50

# ---- PySpark ---------------------------------------------------------------
# SPARK_ENABLED=true                # set to false to always use the original pandas code
# SPARK_MASTER=local[*]
# SPARK_DRIVER_MEMORY=2g
# SPARK_SHUFFLE_PARTITIONS=8
